# Environment Variables Template
# Copy this file to .env.local and fill in the values
# NEVER commit secrets to git - use Netlify environment variables instead

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# TWILIO WHATSAPP CONFIGURATION
# ============================================
# Get these from https://console.twilio.com/

VITE_TWILIO_ACCOUNT_SID=a1f887f7a31397c33c98959ec2046ab4
VITE_TWILIO_AUTH_TOKEN=AC4947a2dedab82eff980cb56df6d5a0d7
VITE_TWILIO_PHONE_NUMBER=+212612989463
VITE_WHATSAPP_SANDBOX=whatsapp:+14155238886
VITE_ADMIN_WHATSAPP=whatsapp:+212612989463

# ============================================
# APPLICATION ENVIRONMENT
# ============================================
# For local development
VITE_APP_ENV=development

# For production (set by Netlify build)
# VITE_APP_ENV=production

# ============================================
# INSTRUCTIONS
# ============================================
# 1. LOCAL DEVELOPMENT:
#    - Copy this file to .env.local
#    - Fill in your credentials
#    - Keep .env.local in .gitignore
#    - Run: pnpm dev
#
# 2. NETLIFY DEPLOYMENT:
#    - Do NOT commit this file with secrets
#    - Add variables in Netlify UI: Site settings → Build & deploy → Environment
#    - Variables to add:
#      VITE_SUPABASE_URL
#      VITE_SUPABASE_ANON_KEY
#      VITE_TWILIO_ACCOUNT_SID
#      VITE_TWILIO_AUTH_TOKEN
#      VITE_TWILIO_PHONE_NUMBER
#      VITE_WHATSAPP_SANDBOX
#      VITE_ADMIN_WHATSAPP
#
# 3. GETTING CREDENTIALS:
#    a) Supabase: https://supabase.com/dashboard → Settings → API
#    b) Twilio: https://console.twilio.com/ → Account SID & Auth Token
#
# 4. USAGE IN CODE:
#    import.meta.env.VITE_SUPABASE_URL
#    import.meta.env.VITE_TWILIO_ACCOUNT_SID
